<?xml version="1.0" encoding="UTF-8"?>
<!--
  Optional for the demo, which is designed to build with plain javac:

      javac -d out src/main/java/io/github/yevhenbozhenko/pool/*.java src/main/java/demo/*.java
      java -cp out demo.Benchmark

  This pom drops the project into a Maven-shaped world unchanged:

      mvn -q compile exec:java

  It is also what publishes the library. See the release profile at the end of the file.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.yevhen-bozhenko</groupId>
  <artifactId>lease-pool</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <!-- Maven Central will not accept a release without the url, licence, developer and scm blocks. -->
  <name>lease-pool</name>
  <description>A reserve-if-free resource pool with expiring leases, and a benchmark of three ways to share one.</description>
  <url>https://github.com/Yevhen-Bozhenko/lease-pool</url>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <name>Yevhen Bozhenko</name>
      <url>https://github.com/Yevhen-Bozhenko</url>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/Yevhen-Bozhenko/lease-pool.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/Yevhen-Bozhenko/lease-pool.git</developerConnection>
    <url>https://github.com/Yevhen-Bozhenko/lease-pool</url>
  </scm>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <exec.mainClass>demo.Benchmark</exec.mainClass>
  </properties>

  <!--
    No runtime dependencies on purpose: everything the demo uses is in java.util.concurrent.
    Both test dependencies are test-scoped, so neither reaches the jar or the plain-javac workflow.
    TestNG is here only so BrokerTestNgExample compiles; nothing in the suite runs against it.
  -->
  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.13.4</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testng</groupId>
      <artifactId>testng</artifactId>
      <version>7.10.2</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.4</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.1</version>
        <configuration>
          <!-- Ship the library and nothing else. An include rather than an exclude: a class added
               outside this package stays out of the jar by default. That also leaves no Main-Class,
               so the jar is no longer runnable; the benchmark runs from target/classes through
               mvn compile exec:java. -->
          <includes>
            <include>io/github/yevhenbozhenko/pool/**</include>
          </includes>
          <!-- The name a consumer writes in "requires". Without it Java builds one from the file
               name, lease.pool, which is not ours to keep and changes if the jar is renamed. -->
          <archive>
            <manifestEntries>
              <Automatic-Module-Name>io.github.yevhenbozhenko.pool</Automatic-Module-Name>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
        <version>3.3.1</version>
        <configuration>
          <!-- Central wants a sources jar. Same list as above, or the demo ships as source. -->
          <includes>
            <include>io/github/yevhenbozhenko/pool/**</include>
          </includes>
        </configuration>
        <executions>
          <execution>
            <id>attach-sources</id>
            <goals>
              <goal>jar-no-fork</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <version>3.11.2</version>
        <configuration>
          <!-- Central wants a javadoc jar. Only the library goes in it, and CI checks that, because
               dropping this line documents the demo as well without failing anything. Javadoc keeps
               its old output, so check a change here with mvn clean verify. -->
          <subpackages>io.github.yevhenbozhenko.pool</subpackages>
          <!-- Javadoc runs all its checks by default. This one turns off the group that wants a
               comment on every member and a tag on every parameter and return, so nothing warns
               if a new method ships with no javadoc. Broken links and bad HTML still fail. -->
          <doclint>all,-missing</doclint>
          <!-- Without this, the module name above makes javadoc look for sources on a module path
               and find none. The build then fails with "No source files for package". -->
          <legacyMode>true</legacyMode>
        </configuration>
        <executions>
          <execution>
            <id>attach-javadocs</id>
            <goals>
              <goal>jar</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.2.0</version>
        <configuration>
          <mainClass>demo.Benchmark</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <!--
    To release: mvn -Prelease deploy. You need a GPG key on a public keyserver, and a Central token
    in ~/.m2/settings.xml under the server id "central". autoPublish is off, so the upload waits in
    the Portal until you press publish. Once published, it stays for good.
  -->
  <profiles>
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <!-- Javadoc never clears its own output folder, so a leftover page from an earlier run
               would ship. Wiping target first is the only way to be sure of what goes up. -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-clean-plugin</artifactId>
            <version>3.5.0</version>
            <executions>
              <execution>
                <id>clean-before-release</id>
                <phase>initialize</phase>
                <goals>
                  <goal>clean</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.8</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <goals>
                  <goal>sign</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>0.11.0</version>
            <extensions>true</extensions>
            <configuration>
              <autoPublish>false</autoPublish>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
